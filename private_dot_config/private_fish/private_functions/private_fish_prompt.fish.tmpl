# ~/.config/fish/functions/fish_prompt.fish
function fish_prompt
    set_color red
    echo -n "┌─["

    set_color blue
    echo -n $TNAME 

    set_color yellow
    echo -n "@"

    set_color cyan
    echo -n {{ .customHostname }}

    set_color red
    echo -n "]─["

    set_color green
    echo -n (prompt_pwd)

    set_color red
    echo "]"

    echo -n "└──╼ "

    set_color red --bold
    echo -n "❯"

    set_color blue
    echo -n "❯"

    set_color brblack
    echo -n "❯ "

    set_color normal
end
